{
  "name": "@cdredfox/dsh-prompt-shortcuts",
  "version": "1.0.0",
  "description": "DSH plugin: save frequently used prompts as a row of shortcut buttons above the composer.",
  "type": "module",
  "license": "MIT",
  "author": "cdredfox",
  "homepage": "https://github.com/cdredfox/dsh-actions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cdredfox/dsh-actions.git"
  },
  "bugs": {
    "url": "https://github.com/cdredfox/dsh-actions/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "prompt",
    "prompt-shortcuts",
    "composer"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "meta": {
    "title": "提示词快捷按钮",
    "description": "把常用提示词存成输入框上方的一排快捷按钮，点击即可填入。"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
